@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models

@inject PackageService package;
@inject IDialogService DialogService;

<MudDataGrid @ref="_dataGrid" Items="@FilteredContentItems" Hover="true" Striped="true" Filterable="true" SortMode="SortMode.Single" QuickFilter="@_quickFilter">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Content Items</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Download" 
                   Color="Color.Primary" 
                   Variant="Variant.Filled" 
                   OnClick="OpenExportDialog"
                   Size="Size.Small"
                   Class="mr-2">
            Export
        </MudButton>
        <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>
    <Columns>
        <HierarchyColumn T="ContentItem" />
        <PropertyColumn Property="x => x.PageURLSegment" Title="URL Segment" />
        <PropertyColumn Property="x => x.Name" Title="Name" />
        <PropertyColumn Property="x => x.ContentTypeName" Title="Content Type" />
        <PropertyColumn Property="x => x.PageStartPublish" Title="Start Publish" />
        <PropertyColumn Property="x => x.PageLanguageBranch" Title="Language" />
        <PropertyColumn Property="x => x.PageMasterLanguageBranch" Title="Master Language" Hideable="true" Hidden="true" />
        <TemplateColumn Title="Actions" Sortable="false" Filterable="false" StickyRight="true">
            <CellTemplate>
                @if (package.IsDeleted(context.Item))
                {
                    <MudChip Color="Color.Error" Size="Size.Small">Deleted</MudChip>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                   Color="Color.Error" 
                                   Size="Size.Small"
                                   OnClick="@(() => DeleteItem(context.Item))"
                                   Title="Delete this content item" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <ChildRowContent>
       <ContentDetails Item="@context.Item"/>
    </ChildRowContent>
</MudDataGrid>

@code{

    private MudDataGrid<ContentItem> _dataGrid;
    private string _searchString;

    private IEnumerable<ContentItem> FilteredContentItems => 
        package.ContentItems?.Where(item => !package.IsDeleted(item)) ?? Enumerable.Empty<ContentItem>();

    private void DeleteItem(ContentItem item)
    {
        package.DeleteContentItem(item);
        StateHasChanged();
    }

    private async Task OpenExportDialog()
    {
        // Get filtered and sorted items from the data grid
        var filteredItems = _dataGrid?.FilteredItems?.ToList() ?? package.ContentItems?.ToList() ?? new List<ContentItem>();
        
        var parameters = new DialogParameters<ExportDialog>
        {
            { x => x.Items, filteredItems },
            { x => x.ItemCount, filteredItems.Count }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<ExportDialog>("Export Content", parameters, options);
    }

    private Func<ContentItem, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.ContentLink!=null && x.ContentLink.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ContentTypeId!=null && x.ContentTypeId.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.Name!=null && x.Name.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ContentTypeName!=null && x.ContentTypeName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.PageURLSegment!=null && x.PageURLSegment.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.ParentLink != null && _searchString.StartsWith("parent:",StringComparison.InvariantCultureIgnoreCase) && x.ParentLink.Contains(_searchString.Replace("parent:","",StringComparison.InvariantCultureIgnoreCase).Trim(), StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    };
}