@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models

@inject PackageService package;

@if (FilteredContentTypes?.Any() == true)
{
    <MudDataGrid Items="@FilteredContentTypes" Hover="true" Striped="true" Filterable="true" SortMode="SortMode.Single">
        <Columns>
            <HierarchyColumn T="ContentTypeDefinition" />
            <PropertyColumn Property="x => x.GroupName" Title="Group"/>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Base" Title="Base" />
            <PropertyColumn Property="x => x.ModelTypeString" Title="Model Type" />
            <PropertyColumn Property="x => x.Properties.Count" Title="# Properties" />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    @if (package.IsDeleted(context.Item))
                    {
                        <MudChip Color="Color.Error" Size="Size.Small">Deleted</MudChip>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteContentType(context.Item))"
                                       Title="Delete this content type" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@context.Item.Name</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudDataGrid Items="@context.Item.Properties.OrderBy(x => x.FieldOrder)" Dense="true">
                        <Columns>
                            <PropertyColumn Property="x => x.Type"/>
                            <PropertyColumn Property="x => x.Name" Title="Name"/>
                            <PropertyColumn Property="x => x.EditCaption" Title="Edit Caption"/>
                            <TemplateColumn Title="Searchable">
                                <CellTemplate Context="item">
                                    @if (item.Item.IsSearchable)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" />
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Required">
                                <CellTemplate Context="item">
                                    @if (item.Item.IsRequired)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" />
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Localizable">
                                <CellTemplate Context="item">
                                    @if (item.Item.IsLocalizable)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" />
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudCardContent>
            </MudCard>
        </ChildRowContent>
     </MudDataGrid>
}
else
{
    <MudText Color="Color.Secondary" Class="mt-2">
        No content types found.
    </MudText>
}

@code {
    private IEnumerable<ContentTypeDefinition> FilteredContentTypes => 
        package.ContentTypes?.Where(ct => !package.IsDeleted(ct)) ?? Enumerable.Empty<ContentTypeDefinition>();
    
    private void DeleteContentType(ContentTypeDefinition contentType)
    {
        package.DeleteContentType(contentType);
        StateHasChanged();
    }
}