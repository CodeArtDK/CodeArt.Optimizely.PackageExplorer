@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models

@inject PackageService package;

@if (FilteredContentTypes?.Any() == true)
{
    <MudDataGrid Items="@FilteredContentTypes" Hover="true" Striped="true" Filterable="true" SortMode="SortMode.Single">
        <Columns>
            <HierarchyColumn T="ContentTypeDefinition" />
            <PropertyColumn Property="x => x.GroupName" Title="Group"/>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Base" Title="Base" />
            <PropertyColumn Property="x => x.ModelTypeString" Title="Model Type" />
            <PropertyColumn Property="x => x.Properties.Count" Title="# Properties" />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    @if (package.IsDeleted(context.Item))
                    {
                        <MudChip Color="Color.Error" Size="Size.Small">Deleted</MudChip>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteContentType(context.Item))"
                                       Title="Delete this content type" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <ChildRowContent>
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@context.Item.Name</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudTooltip Text="Click the edit icon next to property fields to edit them">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" />
                        </MudTooltip>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudDataGrid Items="@context.Item.Properties.OrderBy(x => x.FieldOrder)" Dense="true">
                        <Columns>
                            <PropertyColumn Property="x => x.Type"/>
                            <PropertyColumn Property="x => x.Name" Title="Name"/>
                            <TemplateColumn T="ContentPropertyDefinition" Title="Edit Caption">
                                <CellTemplate Context="item">
                                    @if (_editingPropertyDef == item.Item && _editingField == "EditCaption")
                                    {
                                        <MudTextField Value="@item.Item.EditCaption"
                                                    Variant="Variant.Outlined"
                                                    Immediate="true"
                                                    ValueChanged="@((string val) => { item.Item.EditCaption = val; })"
                                                    OnBlur="@(() => SavePropertyDefEdit(context.Item, item.Item, "EditCaption", item.Item.EditCaption))" />
                                    }
                                    else
                                    {
                                        <MudText>@item.Item.EditCaption</MudText>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Searchable">
                                <CellTemplate Context="item">
                                    @if (_editingPropertyDef == item.Item && _editingField == "IsSearchable")
                                    {
                                        <MudCheckBox Value="item.Item.IsSearchable" 
                                                   Color="Color.Primary"
                                                   T="bool"
                                                   ValueChanged="@((bool val) => { item.Item.IsSearchable = val; SavePropertyDefEdit(context.Item, item.Item, "IsSearchable", val); })" />
                                    }
                                    else
                                    {
                                        @if (item.Item.IsSearchable)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" />
                                        }
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Required">
                                <CellTemplate Context="item">
                                    @if (_editingPropertyDef == item.Item && _editingField == "IsRequired")
                                    {
                                        <MudCheckBox Value="item.Item.IsRequired" 
                                                   Color="Color.Primary"
                                                   T="bool"
                                                   ValueChanged="@((bool val) => { item.Item.IsRequired = val; SavePropertyDefEdit(context.Item, item.Item, "IsRequired", val); })" />
                                    }
                                    else
                                    {
                                        @if (item.Item.IsRequired)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" />
                                        }
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Localizable">
                                <CellTemplate Context="item">
                                    @if (_editingPropertyDef == item.Item && _editingField == "IsLocalizable")
                                    {
                                        <MudCheckBox Value="item.Item.IsLocalizable" 
                                                   Color="Color.Primary"
                                                   T="bool"
                                                   ValueChanged="@((bool val) => { item.Item.IsLocalizable = val; SavePropertyDefEdit(context.Item, item.Item, "IsLocalizable", val); })" />
                                    }
                                    else
                                    {
                                        @if (item.Item.IsLocalizable)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Close" Color="Color.Error" />
                                        }
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn T="ContentPropertyDefinition" Title="Actions">
                                <CellTemplate Context="item">
                                    @if (_editingPropertyDef == item.Item)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" 
                                                     Color="Color.Success" 
                                                     Size="Size.Small"
                                                     OnClick="@(() => ClearEdit())" />
                                    }
                                    else
                                    {
                                        <MudMenu Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Dense="true">
                                            <MudMenuItem OnClick="@(() => StartPropertyDefEdit(item.Item, "EditCaption"))">Edit Caption</MudMenuItem>
                                            <MudMenuItem OnClick="@(() => StartPropertyDefEdit(item.Item, "IsSearchable"))">Toggle Searchable</MudMenuItem>
                                            <MudMenuItem OnClick="@(() => StartPropertyDefEdit(item.Item, "IsRequired"))">Toggle Required</MudMenuItem>
                                            <MudMenuItem OnClick="@(() => StartPropertyDefEdit(item.Item, "IsLocalizable"))">Toggle Localizable</MudMenuItem>
                                        </MudMenu>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </MudCardContent>
            </MudCard>
        </ChildRowContent>
     </MudDataGrid>
}
else
{
    <MudText Color="Color.Secondary" Class="mt-2">
        No content types found.
    </MudText>
}

@code {
    private IEnumerable<ContentTypeDefinition> FilteredContentTypes => 
        package.ContentTypes?.Where(ct => !package.IsDeleted(ct)) ?? Enumerable.Empty<ContentTypeDefinition>();
    
    private ContentPropertyDefinition? _editingPropertyDef;
    private string? _editingField;
    
    private void DeleteContentType(ContentTypeDefinition contentType)
    {
        package.DeleteContentType(contentType);
        StateHasChanged();
    }
    
    private void StartPropertyDefEdit(ContentPropertyDefinition property, string fieldName)
    {
        _editingPropertyDef = property;
        _editingField = fieldName;
    }
    
    private void SavePropertyDefEdit(ContentTypeDefinition contentType, ContentPropertyDefinition property, string fieldName, object newValue)
    {
        package.UpdateContentTypeProperty(contentType, property, fieldName, newValue);
        _editingPropertyDef = null;
        _editingField = null;
        StateHasChanged();
    }
    
    private void ClearEdit()
    {
        _editingPropertyDef = null;
        _editingField = null;
    }
}