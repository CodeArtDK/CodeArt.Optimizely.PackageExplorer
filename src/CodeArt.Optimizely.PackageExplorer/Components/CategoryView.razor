@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models

@inject PackageService package;

@if (FilteredCategories?.Any() == true)
{
    <MudDataGrid Items="@FilteredCategories" Hover="true" Striped="true" Filterable="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="ID"/>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
            <PropertyColumn Property="x => x.ParentId" Title="Parent ID" />
            <PropertyColumn Property="x => x.Selectable" Title="Selectable" />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    @if (package.IsDeleted(context.Item))
                    {
                        <MudChip Color="Color.Error" Size="Size.Small">Deleted</MudChip>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteCategory(context.Item))"
                                       Title="Delete this category" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}
else
{
    <MudText Color="Color.Secondary" Class="mt-2">
        No categories found.
    </MudText>
}

@code {
    private IEnumerable<CategoryDefinition> FilteredCategories => 
        package.Categories?.Where(c => !package.IsDeleted(c)) ?? Enumerable.Empty<CategoryDefinition>();
    
    private void DeleteCategory(CategoryDefinition category)
    {
        package.DeleteCategory(category);
        StateHasChanged();
    }
}