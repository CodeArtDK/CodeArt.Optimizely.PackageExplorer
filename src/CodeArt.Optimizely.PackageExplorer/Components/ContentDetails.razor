@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models
@inject IJSRuntime JS;
@inject PackageService package;

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@("[" + Item.ContentTypeName + "] " + Item.Name)</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if(package.GetContentTypeFromContent(Item).Base=="Image"){
            <ImageBlobView BlobReference="@Item.TryGetProperty("BinaryData")" />
        }

        <MudDataGrid Items="@Item.Properties" Dense="true">
            <Columns>
                <TemplateColumn T="ContentProperty">
                    <CellTemplate Context="property">
                        @if (property.Item.Name.StartsWith("Page") && property.Item.PropertyDefinitionID == 0)
                        {
                            <MudBadge Color="Color.Info"
                            Variant="Variant.Filled"
                            Class="mr-2"
                            Content="@("System")" />
                        }
                        @if (property.Item.IsBlock)
                        {
                            <MudBadge Color="Color.Primary"
                            Variant="Variant.Filled"
                            Class="mr-2"
                            Content="@("Block")" />
                        }
                        @if (property.Item.IsList)
                        {
                            <MudBadge Color="Color.Secondary"
                            Variant="Variant.Filled"
                            Class="mr-2"
                            Content="@("List")" />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ContentProperty" Title="Name">
                    <CellTemplate Context="property">

                        <MudText>

                            @property.Item.Name

                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ContentProperty" Title="Value">
                    <CellTemplate Context="property">
                        @if (property.Item.HasNestedContent)
                        {
                            @* Show a summary for nested content *@
                            @if (property.Item.IsBlock && !string.IsNullOrEmpty(property.Item.BlockTypeName))
                            {
                                <MudText Class="text-muted">Block: @property.Item.BlockTypeName</MudText>
                            }
                            else if (property.Item.IsList)
                            {
                                <MudText Class="text-muted">@(property.Item.ListProperties?.Count ?? 0) item(s)</MudText>
                            }
                        }
                        else if (property.Item.TypeName == "EPiServer.SpecializedProperties.PropertyXhtmlString")
                        {
                            <pre style="width:100%"><code class="language-html">@property.Item.Value</code></pre>

                        }
                        else
                        {
                            <MudText>@property.Item.Value</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <ChildRowContent>
                @if (context.Item.HasNestedContent)
                {
                    <MudTr>
                        <td colspan="3" style="padding: 16px; background-color: #f5f5f5;">
                            <PropertyDisplay Property="@context.Item" Level="0" />
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
        </MudDataGrid>
    </MudCardContent>
</MudCard>




@code {

    [Parameter]
    public ContentItem Item { get; set; }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender){
            await JS.InvokeVoidAsync("Prism.highlightAll");
        }
    }

}
