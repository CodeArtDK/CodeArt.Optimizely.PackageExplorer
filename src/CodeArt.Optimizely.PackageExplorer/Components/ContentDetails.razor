@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models
@inject IJSRuntime JS;
@inject PackageService package;

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@("[" + Item.ContentTypeName + "] " + Item.Name)</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudTooltip Text="Click the edit icon next to any property to edit it">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" />
            </MudTooltip>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        @if(package.GetContentTypeFromContent(Item).Base=="Image"){
            <ImageBlobView BlobReference="@Item.TryGetProperty("BinaryData")" />
        }

        <MudDataGrid Items="@Item.Properties" Dense="true">
            <Columns>
                <TemplateColumn T="ContentProperty" Title="Actions">
                    <CellTemplate Context="property">
                        @if (_editingProperty == property.Item)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check" 
                                         Color="Color.Success" 
                                         Size="Size.Small"
                                         OnClick="@(() => SavePropertyEdit(property.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                         Color="Color.Default" 
                                         Size="Size.Small"
                                         OnClick="@(() => CancelPropertyEdit())" />
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                         Color="Color.Primary" 
                                         Size="Size.Small"
                                         OnClick="@(() => StartPropertyEdit(property.Item))" />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ContentProperty">
                    <CellTemplate Context="property">
                        @if (property.Item.Name.StartsWith("Page") && property.Item.PropertyDefinitionID == 0)
                        {
                            <MudBadge Color="Color.Info"
                            Variant="Variant.Outlined"
                            Class="mr-2"
                            Content="@("System")" />
                        }
                        @if (package.IsPropertyModified(Item, property.Item.Name))
                        {
                            <MudBadge Color="Color.Warning"
                            Variant="Variant.Outlined"
                            Class="mr-2"
                            Content="@("Modified")" />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ContentProperty" Title="Name">
                    <CellTemplate Context="property">
                        <MudText>@property.Item.Name</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ContentProperty" Title="Value">
                    <CellTemplate Context="property">
                        @if (_editingProperty == property.Item)
                        {
                            @if (property.Item.TypeName == "EPiServer.SpecializedProperties.PropertyXhtmlString")
                            {
                                <MudTextField @bind-Value="property.Item.Value" 
                                            Lines="5" 
                                            Variant="Variant.Outlined"
                                            FullWidth="true"
                                            OnBlur="@(() => SavePropertyEdit(property.Item))"
                                            Immediate="true" />
                            }
                            else
                            {
                                <MudTextField @bind-Value="property.Item.Value" 
                                            Variant="Variant.Outlined"
                                            FullWidth="true"
                                            OnBlur="@(() => SavePropertyEdit(property.Item))"
                                            Immediate="true" />
                            }
                        }
                        else
                        {
                            @if (property.Item.TypeName == "EPiServer.SpecializedProperties.PropertyXhtmlString")
                            {
                                <pre style="width:100%"><code class="language-html">@property.Item.Value</code></pre>
                            }
                            else
                            {
                                <MudText>@property.Item.Value</MudText>
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudCardContent>
</MudCard>




@code {

    [Parameter]
    public ContentItem Item { get; set; }

    private ContentProperty? _editingProperty;
    private string? _originalValue;

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender){
            await JS.InvokeVoidAsync("Prism.highlightAll");
        }
    }

    private void StartPropertyEdit(ContentProperty property)
    {
        _editingProperty = property;
        _originalValue = property.Value;
    }

    private void SavePropertyEdit(ContentProperty property)
    {
        if (property.Value != null && property.Value != _originalValue)
        {
            package.UpdateContentProperty(Item, property.Name, property.Value);
        }
        _editingProperty = null;
        _originalValue = null;
    }

    private void CancelPropertyEdit()
    {
        if (_editingProperty != null && _originalValue != null)
        {
            _editingProperty.Value = _originalValue;
        }
        _editingProperty = null;
        _originalValue = null;
    }

}
