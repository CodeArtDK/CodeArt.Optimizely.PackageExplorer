@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models
@inject IJSRuntime JS;
@inject PackageService package;

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@($"[{Item?.ContentTypeName ?? "?"}] {Item?.Name ?? "(no name)"}")</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @* Guard against null item or null content type *@
        @{
            var contentType = Item is not null ? package?.GetContentTypeFromContent(Item) : null;
        }
        @if (Item is not null && contentType?.Base == "Image")
        {
            <ImageBlobView BlobReference="@Item.TryGetProperty("BinaryData")" />
        }

        @if (Item?.Properties is not null)
        {
            <MudDataGrid Items="@Item.Properties" Dense="true">
                <Columns>
                    <HierarchyColumn T="ContentProperty" />
                    <TemplateColumn T="ContentProperty">
                        <CellTemplate Context="property">
                            @if (property?.Item?.Name?.StartsWith("Page") == true && property.Item.PropertyDefinitionID == 0)
                            {
                                <MudBadge Color="Color.Info"
                                          Variant="Variant.Outlined"
                                          Class="mr-2"
                                          Content="@("System")" />
                            }
                            @if (property?.Item?.BlockType != null)
                            {
                                <MudBadge Color="Color.Primary"
                                          Variant="Variant.Outlined"
                                          Class="mr-2"
                                          Content="@(property.Item.BlockType.Name)" />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ContentProperty" Title="Name">
                        <CellTemplate Context="property">
                            <MudText>
                                @property?.Item?.Name
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ContentProperty" Title="Value">
                        <CellTemplate Context="property">
                            @if (property?.Item?.TypeName == "EPiServer.VisualBuilder.PropertyLayout")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">Layout JSON</MudChip>
                            }
                            else if (property?.Item?.TypeName == "EPiServer.SpecializedProperties.PropertyXhtmlString")
                            {
                                <pre style="width:100%"><code class="language-html">@property.Item.Value</code></pre>
                            }
                            else if (property?.Item?.HasNestedData == true)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">
                                    @(property.Item.BlockProperties.Count + property.Item.ListItems.Count) nested
                                </MudChip>
                            }
                            else
                            {
                                <MudText>@property?.Item?.Value</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <ChildRowContent>
                    <MudPaper Class="pa-3 ma-2" Elevation="0" Outlined="true">
                        @if (context.Item.TypeName == "EPiServer.VisualBuilder.PropertyLayout" && !string.IsNullOrWhiteSpace(context.Item.Value))
                        {
                            <LayoutTreeView Json="@context.Item.Value" />
                        }
                        @if (context.Item.BlockProperties.Any())
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-1">Block Properties:</MudText>
                            <NestedPropertyList Properties="@context.Item.BlockProperties" />
                        }
                        @if (context.Item.ListItems.Any())
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-1 mt-2">List Items (@context.Item.ListItems.Count):</MudText>
                            @foreach (var listItem in context.Item.ListItems)
                            {
                                <MudPaper Class="pa-2 ma-1" Elevation="0" Outlined="true">
                                    @if (listItem.BlockType != null)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@listItem.BlockType.Name</MudChip>
                                    }
                                    @if (listItem.BlockProperties.Any())
                                    {
                                        <NestedPropertyList Properties="@listItem.BlockProperties" Depth="1" />
                                    }
                                </MudPaper>
                            }
                        }
                        @if (!context.Item.HasNestedData && context.Item.TypeName != "EPiServer.VisualBuilder.PropertyLayout")
                        {
                            <MudText Typo="Typo.body2">
                                <strong>Type:</strong> @context.Item.TypeName<br />
                                <strong>Value:</strong> @context.Item.Value
                            </MudText>
                        }
                    </MudPaper>
                </ChildRowContent>
            </MudDataGrid>
        }
        else
        {
            <MudText Color="Color.Error">No properties available for this content item.</MudText>
        }
    </MudCardContent>
</MudCard>

@code {

    [Parameter]
    public ContentItem Item { get; set; }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("Prism.highlightAll");
        }
    }

}
