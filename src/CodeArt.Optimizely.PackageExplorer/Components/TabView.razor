@using CodeArt.Optimizely.PackageExplorer.Services
@using CodeArt.Optimizely.PackageExplorer.Core.Models

@inject PackageService package;

@if (FilteredTabs?.Any() == true)
{
    <MudDataGrid Items="@FilteredTabs" Hover="true" Striped="true" Filterable="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.Id" Title="ID"/>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.DisplayName" Title="Display Name" />
            <PropertyColumn Property="x => x.SortIndex" Title="Sort Index" />
            <PropertyColumn Property="x => x.IsSystemTab" Title="System Tab" />
            <TemplateColumn Title="Actions">
                <CellTemplate>
                    @if (package.IsDeleted(context.Item))
                    {
                        <MudChip Color="Color.Error" Size="Size.Small">Deleted</MudChip>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteTab(context.Item))"
                                       Title="Delete this tab" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}
else
{
    <MudText Color="Color.Secondary" Class="mt-2">
        No tab definitions found.
    </MudText>
}

@code {
    private IEnumerable<TabDefinition> FilteredTabs => 
        package.Tabs?.Where(t => !package.IsDeleted(t)) ?? Enumerable.Empty<TabDefinition>();
    
    private void DeleteTab(TabDefinition tab)
    {
        package.DeleteTab(tab);
        StateHasChanged();
    }
}
